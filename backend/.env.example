NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=novax_iot
DB_USER=novax_app
DB_PASS=
DB_LOGGING=false
DB_BRANCH_DATABASES=false

# Prefer the existing NOVAX external_id when explicitly pinning an installation.
# Leave empty to resolve the existing organization with slug novax-iot.
NOVAX_TENANT_EXTERNAL_ID=
NOVAX_TENANT_SLUG=novax-iot

WEB_ORIGIN=http://127.0.0.1:4200
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Configure at least 32 random characters only for initializing a fresh database.
BOOTSTRAP_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Explicit reverse-proxy addresses/networks only. Leave unset without a proxy.
TRUST_PROXY=
# MQTT is opt-in. In production use mqtts:// with valid certificates and credentials.
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=novax-ingestion-v1
MQTT_USERNAME=
MQTT_PASSWORD=
