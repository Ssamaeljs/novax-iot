# Configuración de Compose para laboratorio. Ejecuta node docker/init-env.cjs
# para crear .env con secretos aleatorios. No se utiliza backend/.env.
COMPOSE_PROJECT_NAME=novax-iot
NOVAX_WEB_PORT=8080
NOVAX_MQTT_PORT=1883
# IP privada del anfitrión para aceptar clientes MQTT desde la red local.
NOVAX_MQTT_LAN_IP=127.0.0.1

NOVAX_DB_NAME=novax_iot
NOVAX_DB_USER=novax_app
NOVAX_DB_PASSWORD=
NOVAX_BOOTSTRAP_SECRET=

