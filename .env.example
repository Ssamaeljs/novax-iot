# Configuración de Compose para laboratorio. Ejecuta node docker/init-env.cjs
# para crear .env con secretos aleatorios. No se utiliza backend/.env.
COMPOSE_PROJECT_NAME=novax-iot
NOVAX_WEB_PORT=8080
NOVAX_MQTT_PORT=1883

NOVAX_DB_NAME=novax_iot
NOVAX_DB_USER=novax_app
NOVAX_DB_PASSWORD=
NOVAX_BOOTSTRAP_SECRET=

MQTT_ENABLED=true
# Nombre del servicio dentro de Docker; desde el host usa 127.0.0.1.
MQTT_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=novax-ingestion-lab
MQTT_USERNAME=novax_backend
MQTT_PASSWORD=
MQTT_TEST_USERNAME=novax_emitter
MQTT_TEST_PASSWORD=
